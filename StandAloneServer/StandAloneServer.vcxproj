  <!--
    Include path priority is important:
      1) shim\                                          - our minimal headers (global.h, RageLog.h, ...)
      2) ..\src\                                        - the real StepMania headers we WANT (StdString.h, NetworkSyncServer.h, ezsockets.h, ...)
      3) ..\src\ThirdParty_rebuild\steam sdk\public     - Steam API
    Anything we override (global.h, PlayerNumber.h, Difficulty.h, RageLog.h, PrefsManager.h) is picked up from shim\ first.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <AdditionalOptions>/EHa /wd4100 /wd4244 /wd4267 /wd4305 /wd4996 /FI"$(ProjectDir)shim\global.h" %(AdditionalOptions)</AdditionalOptions>
      <Optimization>Disabled</Optimization>
      <AdditionalIncludeDirectories>shim;..\src;..\src\ThirdParty_rebuild\steam sdk\public;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;WINDOWS;_DEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;_USING_V110_SDK71_;WINDOWS_IGNORE_PACKING_MISMATCH;_ITERATOR_DEBUG_LEVEL=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
